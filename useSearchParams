.search-params-page {
  min-height: 100vh;
  padding: 40px 20px;
  background: #f4f6f8;
  box-sizing: border-box;
}

.search-params-container {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  background: #ffffff;
  border-radius: 16px;
  padding: 30px;
  box-sizing: border-box;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
}

.search-params-header {
  text-align: center;
  margin-bottom: 30px;
}

.search-params-header h1 {
  margin: 0 0 8px;
  font-size: 30px;
  color: #1f2937;
}

.search-params-header p {
  margin: 0;
  color: #6b7280;
  font-size: 15px;
}

.table-wrapper {
  width: 100%;
  overflow-x: auto;
  border-radius: 12px;
  border: 1px solid #e5e7eb;
}

.users-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 700px;
}

.users-table thead {
  background: #1f2937;
}

.users-table th {
  padding: 15px 18px;
  text-align: left;
  color: #ffffff;
  font-size: 14px;
  font-weight: 600;
}

.users-table td {
  padding: 15px 18px;
  border-bottom: 1px solid #e5e7eb;
  color: #374151;
  font-size: 14px;
}

.users-table tbody tr {
  transition: background-color 0.2s ease;
}

.users-table tbody tr:hover {
  background: #f8fafc;
}

.users-table tbody tr:last-child td {
  border-bottom: none;
}

.role-badge {
  display: inline-block;
  padding: 6px 12px;
  border-radius: 20px;
  background: #eef2ff;
  color: #4338ca;
  font-size: 12px;
  font-weight: 600;
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 25px;
  margin-top: 30px;
}

.pagination-button {
  min-width: 130px;
  padding: 11px 18px;
  border: none;
  border-radius: 8px;
  background: #1f2937;
  color: #ffffff;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.2s ease;
}

.pagination-button:hover:not(:disabled) {
  background: #111827;
  transform: translateY(-1px);
}

.pagination-button:active:not(:disabled) {
  transform: translateY(0);
}

.pagination-button:disabled {
  background: #d1d5db;
  color: #6b7280;
  cursor: not-allowed;
}

.page-info {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #6b7280;
  font-size: 15px;
}

.page-info strong {
  min-width: 32px;
  height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: #eef2ff;
  color: #4338ca;
}

@media (max-width: 700px) {
  .search-params-page {
    padding: 20px 12px;
  }

  .search-params-container {
    padding: 20px 15px;
    border-radius: 12px;
  }

  .search-params-header h1 {
    font-size: 24px;
  }

  .pagination {
    gap: 12px;
  }

  .pagination-button {
    min-width: 110px;
    padding: 10px 12px;
  }
}

@media (max-width: 500px) {
  .pagination {
    flex-direction: column;
    gap: 15px;
  }

  .pagination-button {
    width: 100%;
  }

  .page-info {
    order: -1;
  }
}
